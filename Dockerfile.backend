

FROM node:20-alpine

WORKDIR /app

# Instalar dependencias de producción
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copiar el backend
COPY backend ./backend

# Copiar los scripts de inicialización
COPY scripts ./scripts

# Copiar el catálogo de ejemplo
COPY data/tienda.example.json ./data/tienda.example.json

# Configuración del servidor
ENV NODE_ENV=production
ENV PORT=10000

EXPOSE 10000

CMD ["sh", "-c", "node scripts/init-postgres.js && node backend/src/server.js"]
